// Memory and aggregate instructions: alloca, load, store, getelementptr, extractvalue, insertvalue, select, call.
// https://llvm.org/docs/LangRef.html#memory-access-and-addressing-operations
from "std" import String, Vec
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEqStr
from "support" import text, expectHas, sig0, sig1, sig2, one, two
import * from "xl-llvm"

fn stackSlot(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("f"), sig1(&ctx, i32t, i32t))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local slot: Value = b.alloca(i32t, 4)
    b.store(f.arg(0), slot, 4)
    local v: Value = b.load(i32t, slot, 4)
    local vol: Value = b.alloca(ctx.int64(), 0)
    b.store(ctx.constInt(ctx.int64(), 7), vol, 0)
    b.ret(v)
    local s: String = text(&m)
    expectHas(t, &s, "  %1 = alloca i32, align 4\n")
    expectHas(t, &s, "  store i32 %0, ptr %1, align 4\n")
    expectHas(t, &s, "  %2 = load i32, ptr %1, align 4\n")
    expectHas(t, &s, "  %3 = alloca i64\n")
    expectHas(t, &s, "  store i64 7, ptr %3\n")
    expectHas(t, &s, "  ret i32 %2\n")
}

fn addressing(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local arr: Type = ctx.arrayType(ctx.int32(), 8)
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.ptr(), ctx.ptr()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local idx: Vec<Value> = two(ctx.constInt(ctx.int64(), 0), ctx.constInt(ctx.int64(), 3))
    local inb: Value = b.gep(arr, f.arg(0), idx, true)
    local plain: Value = b.gep(ctx.int8(), inb, one(ctx.constInt(ctx.int64(), 16)), false)
    b.ret(plain)
    local s: String = text(&m)
    expectHas(t, &s, "  %1 = getelementptr inbounds [8 x i32], ptr %0, i64 0, i64 3\n")
    expectHas(t, &s, "  %2 = getelementptr i8, ptr %1, i64 16\n")
}

fn aggregates(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local fields: Vec<Type> = Vec<Type>()
    fields.push(ctx.int32())
    fields.push(ctx.int64())
    local pair: Type = ctx.structType(fields, false)
    local f: Function = m.addFunction(String("f"), sig2(&ctx, pair, pair, ctx.int32()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local second: Value = b.extractValue(f.arg(0), 1)
    local updated: Value = b.insertValue(f.arg(0), f.arg(1), 0)
    b.ret(updated)
    local s: String = text(&m)
    expectHas(t, &s, "  %2 = extractvalue { i32, i64 } %0, 1\n")
    expectHas(t, &s, "  %3 = insertvalue { i32, i64 } %0, i32 %1, 0\n")
    expectHas(t, &s, "  ret { i32, i64 } %3\n")
}

fn selecting(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local p: Vec<Type> = Vec<Type>()
    p.push(ctx.int1())
    p.push(i32t)
    p.push(i32t)
    local f: Function = m.addFunction(String("f"), ctx.fnType(i32t, p))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local r: Value = b.select(f.arg(0), f.arg(1), f.arg(2))
    b.ret(r)
    local s: String = text(&m)
    expectHas(t, &s, "  %3 = select i1 %0, i32 %1, i32 %2\n")
}

fn calls(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local callee: Function = m.addFunction(String("g"), sig1(&ctx, i32t, i32t))
    local noret: Function = m.addFunction(String("h"), sig0(&ctx, ctx.voidType()))
    local pv: Vec<Type> = Vec<Type>()
    pv.push(ctx.ptr())
    local printf: Function = m.addFunction(String("printf"), ctx.fnType(i32t, pv, true))
    local f: Function = m.addFunction(String("f"), sig2(&ctx, i32t, ctx.ptr(), ctx.ptr()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local r: Value = b.callFn(callee, one(ctx.constInt(i32t, 5)))
    b.callFn(noret, Vec<Value>())
    b.callFn(printf, two(f.arg(0), r))
    local indirect: Value = b.call(f.arg(1), callee.fnType(), one(r))
    b.ret(indirect)
    local s: String = text(&m)
    expectHas(t, &s, "declare i32 @g(i32)\n")
    expectHas(t, &s, "  %2 = call i32 @g(i32 5)\n")
    expectHas(t, &s, "  call void @h()\n")
    expectHas(t, &s, "  %3 = call i32 (ptr, ...) @printf(ptr %0, i32 %2)\n")
    expectHas(t, &s, "  %4 = call i32 %1(i32 %2)\n")
}

fn callChecks(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local callee: Function = m.addFunction(String("g"), sig1(&ctx, ctx.int32(), ctx.int32()))
    local f: Function = m.addFunction(String("f"), sig0(&ctx, ctx.voidType()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.callFn(callee, Vec<Value>())
    b.retVoid()
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: call: 0 arguments for a function of 1 parameters")
    local ctx2: Context = Context()
    local m2: Module = Module(&ctx2, String("t"))
    local callee2: Function = m2.addFunction(String("g"), sig1(&ctx2, ctx2.int32(), ctx2.int32()))
    local f2: Function = m2.addFunction(String("f"), sig0(&ctx2, ctx2.voidType()))
    local b2: Builder = Builder(&ctx2)
    b2.setInsertPoint(f2.addBlock(String("entry")))
    b2.callFn(callee2, one(ctx2.constInt(ctx2.int64(), 1)))
    b2.retVoid()
    local s2: String = text(&m2)
    expectEqStr(t, s2.asStr(), "error: call: argument 0 has the wrong type")
}

fn pointerChecks(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.int32(), ctx.int32()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.load(ctx.int32(), f.arg(0), 0)             // an i32 is not an address
    b.ret(f.arg(0))
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: load: the address is not a pointer")
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "alloca, load and store", stackSlot)
    test(&s, "getelementptr", addressing)
    test(&s, "extractvalue and insertvalue", aggregates)
    test(&s, "select", selecting)
    test(&s, "direct, void, vararg and indirect calls", calls)
    test(&s, "call arguments are checked", callChecks)
    test(&s, "load needs a pointer", pointerChecks)
    return suiteRun(&s)
}
