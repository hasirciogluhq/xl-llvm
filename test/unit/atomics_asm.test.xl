// Atomics, fences, inline assembly and intrinsic declarations.
// https://llvm.org/docs/LangRef.html#atomicrmw-instruction, https://llvm.org/docs/LangRef.html#inline-assembler-expressions
from "std" import String, Vec
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEqStr, expectEq
from "support" import text, expectHas, sig0, sig1, sig2, one
import * from "xl-llvm"

fn atomicRmwForms(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, i32t, ctx.ptr(), i32t))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local p: Value = f.arg(0)
    local v: Value = f.arg(1)
    b.atomicRmw(AtomicOp.Xchg, p, v, AtomicOrdering.Monotonic, 4)
    b.atomicRmw(AtomicOp.Add, p, v, AtomicOrdering.SeqCst, 4)
    b.atomicRmw(AtomicOp.Sub, p, v, AtomicOrdering.AcqRel, 4)
    b.atomicRmw(AtomicOp.And, p, v, AtomicOrdering.Acquire, 4)
    b.atomicRmw(AtomicOp.Or, p, v, AtomicOrdering.Release, 4)
    b.atomicRmw(AtomicOp.Xor, p, v, AtomicOrdering.SeqCst, 4)
    b.atomicRmw(AtomicOp.UMax, p, v, AtomicOrdering.SeqCst, 0)
    b.fence(AtomicOrdering.SeqCst)
    b.ret(v)
    local s: String = text(&m)
    expectHas(t, &s, "  %2 = atomicrmw xchg ptr %0, i32 %1 monotonic, align 4\n")
    expectHas(t, &s, "  %3 = atomicrmw add ptr %0, i32 %1 seq_cst, align 4\n")
    expectHas(t, &s, "  %4 = atomicrmw sub ptr %0, i32 %1 acq_rel, align 4\n")
    expectHas(t, &s, "  %5 = atomicrmw and ptr %0, i32 %1 acquire, align 4\n")
    expectHas(t, &s, "  %6 = atomicrmw or ptr %0, i32 %1 release, align 4\n")
    expectHas(t, &s, "  %7 = atomicrmw xor ptr %0, i32 %1 seq_cst, align 4\n")
    expectHas(t, &s, "  %8 = atomicrmw umax ptr %0, i32 %1 seq_cst\n")
    expectHas(t, &s, "  fence seq_cst\n")
}

fn compareExchange(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local p: Vec<Type> = Vec<Type>()
    p.push(ctx.ptr())
    p.push(i32t)
    p.push(i32t)
    local f: Function = m.addFunction(String("f"), ctx.fnType(ctx.int1(), p))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local pair: Value = b.cmpXchg(f.arg(0), f.arg(1), f.arg(2), AtomicOrdering.SeqCst, AtomicOrdering.Monotonic, 4)
    local ok: Value = b.extractValue(pair, 1)
    b.ret(ok)
    local s: String = text(&m)
    expectHas(t, &s, "  %3 = cmpxchg ptr %0, i32 %1, i32 %2 seq_cst monotonic, align 4\n")
    expectHas(t, &s, "  %4 = extractvalue { i32, i1 } %3, 1\n")
}

fn atomicChecks(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.voidType(), ctx.int32()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.atomicRmw(AtomicOp.Add, f.arg(0), f.arg(0), AtomicOrdering.SeqCst, 4)   // not a pointer
    b.retVoid()
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: atomicrmw: needs a pointer and an integer value")
}

fn inlineAssembly(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig0(&ctx, ctx.int32()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local nop: Value = ctx.inlineAsm(String("nop"), String(""), true, false)
    b.call(nop, sig0(&ctx, ctx.voidType()), Vec<Value>())
    local intel: Value = ctx.inlineAsm(String("mov $0, 1"), String("=r"), false, true)
    local r: Value = b.call(intel, sig0(&ctx, ctx.int32()), Vec<Value>())
    b.ret(r)
    local s: String = text(&m)
    expectHas(t, &s, "  call void asm sideeffect \"nop\", \"\"()\n")
    expectHas(t, &s, "  %0 = call i32 asm inteldialect \"mov $0, 1\", \"=r\"()\n")
}

fn intrinsics(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.voidType(), ctx.ptr()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local args: Vec<Value> = Vec<Value>()
    args.push(f.arg(0))
    args.push(f.arg(0))
    args.push(ctx.constInt(ctx.int64(), 16))
    args.push(ctx.constBool(false))
    b.callFn(memcpy(&m), args)
    local fill: Vec<Value> = Vec<Value>()
    fill.push(f.arg(0))
    fill.push(ctx.constInt(ctx.int8(), 0))
    fill.push(ctx.constInt(ctx.int64(), 16))
    fill.push(ctx.constBool(false))
    b.callFn(memset(&m), fill)
    b.callFn(trap(&m), Vec<Value>())
    b.callFn(trap(&m), Vec<Value>())
    b.unreachable()
    local s: String = text(&m)
    expectHas(t, &s, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n")
    expectHas(t, &s, "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n")
    expectHas(t, &s, "declare void @llvm.trap() noreturn nounwind\n")
    expectHas(t, &s, "  call void @llvm.memcpy.p0.p0.i64(ptr %0, ptr %0, i64 16, i1 false)\n")
    expectEq(t, m.funcs.length() as i64, 4)      // f, memcpy, memset and one trap
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "atomicrmw and fence", atomicRmwForms)
    test(&s, "cmpxchg", compareExchange)
    test(&s, "atomicrmw checks its operands", atomicChecks)
    test(&s, "inline assembly, AT&T and Intel", inlineAssembly)
    test(&s, "intrinsic declarations are made once", intrinsics)
    return suiteRun(&s)
}
