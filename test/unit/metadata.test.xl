// Metadata nodes: strings, tuples, specialized nodes, named metadata, numbering and `metadata` operands.
// https://llvm.org/docs/LangRef.html#metadata
from "std" import String, Vec
from "std/testing" import Suite, T, suiteInit, test, suiteRun, testFail
from "support" import text, expectHas, expectNotHas
import * from "xl-llvm"

fn tuplesAndNamed(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local md: Metadata = Metadata(&ctx)
    local items: Vec<Md> = Vec<Md>()
    items.push(md.text(String("hello")))
    items.push(md.value(ctx.constInt(ctx.int32(), 7)))
    items.push(md.null())
    m.addNamed(String("my.list"), md.tuple(items))
    local s: String = text(&m)
    expectHas(t, &s, "!my.list = !{!0}\n")
    expectHas(t, &s, "!0 = !{!\"hello\", i32 7, null}\n")
}

fn specialNodes(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local md: Metadata = Metadata(&ctx)
    local file: Md = md.special(String("DIFile"), false)
    md.setString(file, String("filename"), String("a.xl"))
    local unit: Md = md.special(String("DICompileUnit"), true)
    md.setWord(unit, String("language"), String("DW_LANG_C99"))
    md.setNode(unit, String("file"), file)
    md.setBool(unit, String("isOptimized"), false)
    md.setInt(unit, String("runtimeVersion"), 0)
    m.addNamed(String("llvm.dbg.cu"), unit)
    local s: String = text(&m)
    expectHas(t, &s, "!llvm.dbg.cu = !{!0}\n")
    expectHas(t, &s, "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, isOptimized: false, runtimeVersion: 0)\n")
    expectHas(t, &s, "!1 = !DIFile(filename: \"a.xl\")\n")
}

fn unusedNodesAreNotPrinted(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local md: Metadata = Metadata(&ctx)
    local lost: Md = md.special(String("DIFile"), false)
    md.setString(lost, String("filename"), String("never.xl"))
    local s: String = text(&m)
    expectNotHas(t, &s, "never.xl")
}

fn moduleFlagsAreNodes(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    m.addFlag(FlagBehavior.Warning, String("Dwarf Version"), 5)
    m.addFlag(FlagBehavior.Error, String("wchar_size"), 4)
    local s: String = text(&m)
    expectHas(t, &s, "!llvm.module.flags = !{!0, !1}\n")
    expectHas(t, &s, "!0 = !{i32 2, !\"Dwarf Version\", i32 5}\n")
    expectHas(t, &s, "!1 = !{i32 1, !\"wchar_size\", i32 4}\n")
}

fn numberingIsStable(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    m.addFlag(FlagBehavior.Max, String("k"), 1)
    local a: String = text(&m)
    local b: String = text(&m)       // printing twice renumbers from scratch
    if !a.equals(&b) { testFail(t, "a second print differs from the first") }
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "tuples and named metadata", tuplesAndNamed)
    test(&s, "specialized nodes", specialNodes)
    test(&s, "unused nodes are not printed", unusedNodesAreNotPrinted)
    test(&s, "module flags are metadata nodes", moduleFlagsAreNodes)
    test(&s, "numbering is stable", numberingIsStable)
    return suiteRun(&s)
}
