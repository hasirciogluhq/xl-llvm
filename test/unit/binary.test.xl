// Integer and floating-point arithmetic, bitwise operations, wrap flags, fneg, freeze and the builder's operand checks.
// https://llvm.org/docs/LangRef.html#binary-operations
from "std" import String, Vec
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectTrue, expectEqStr
from "support" import text, expectHas, sig2, sig1
import * from "xl-llvm"

fn intOps(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, i32t, i32t, i32t))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local x: Value = f.arg(0)
    local y: Value = f.arg(1)
    ctx.setName(x, String("x"))
    ctx.setName(y, String("y"))
    local sum: Value = b.add(x, y)
    b.sub(sum, y)
    b.mul(x, y)
    b.udiv(x, y)
    b.sdiv(x, y)
    b.urem(x, y)
    b.srem(x, y)
    b.shl(x, y)
    b.lshr(x, y)
    b.ashr(x, y)
    b.bitAnd(x, y)
    b.bitOr(x, y)
    b.bitXor(x, y)
    b.ret(sum)
    local s: String = text(&m)
    expectHas(t, &s, "define i32 @f(i32 %x, i32 %y) {\nentry:\n")
    expectHas(t, &s, "  %0 = add i32 %x, %y\n")
    expectHas(t, &s, "  %1 = sub i32 %0, %y\n")
    expectHas(t, &s, "  %2 = mul i32 %x, %y\n")
    expectHas(t, &s, "  %3 = udiv i32 %x, %y\n")
    expectHas(t, &s, "  %4 = sdiv i32 %x, %y\n")
    expectHas(t, &s, "  %5 = urem i32 %x, %y\n")
    expectHas(t, &s, "  %6 = srem i32 %x, %y\n")
    expectHas(t, &s, "  %7 = shl i32 %x, %y\n")
    expectHas(t, &s, "  %8 = lshr i32 %x, %y\n")
    expectHas(t, &s, "  %9 = ashr i32 %x, %y\n")
    expectHas(t, &s, "  %10 = and i32 %x, %y\n")
    expectHas(t, &s, "  %11 = or i32 %x, %y\n")
    expectHas(t, &s, "  %12 = xor i32 %x, %y\n")
    expectHas(t, &s, "  ret i32 %0\n")
}

fn wrapFlags(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i64t: Type = ctx.int64()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, i64t, i64t, i64t))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.addNsw(f.arg(0), f.arg(1))
    b.bin(BinOp.Mul, f.arg(0), f.arg(1), FlagNuw | FlagNsw)
    b.bin(BinOp.LShr, f.arg(0), f.arg(1), FlagExact)
    b.bin(BinOp.Or, f.arg(0), f.arg(1), FlagDisjoint)
    b.ret(f.arg(0))
    local s: String = text(&m)
    expectHas(t, &s, "  %2 = add nsw i64 %0, %1\n")
    expectHas(t, &s, "  %3 = mul nuw nsw i64 %0, %1\n")
    expectHas(t, &s, "  %4 = lshr exact i64 %0, %1\n")
    expectHas(t, &s, "  %5 = or disjoint i64 %0, %1\n")
}

fn floatOps(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local d: Type = ctx.float64()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, d, d, d))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local x: Value = f.arg(0)
    local y: Value = f.arg(1)
    b.fadd(x, y)
    b.fsub(x, y)
    b.fmul(x, y)
    b.fdiv(x, y)
    b.frem(x, y)
    local n: Value = b.fneg(x)
    b.ret(n)
    local s: String = text(&m)
    expectHas(t, &s, "define double @f(double %0, double %1) {\n")
    expectHas(t, &s, "  %2 = fadd double %0, %1\n")
    expectHas(t, &s, "  %3 = fsub double %0, %1\n")
    expectHas(t, &s, "  %4 = fmul double %0, %1\n")
    expectHas(t, &s, "  %5 = fdiv double %0, %1\n")
    expectHas(t, &s, "  %6 = frem double %0, %1\n")
    expectHas(t, &s, "  %7 = fneg double %0\n")
    expectHas(t, &s, "  ret double %7\n")
}

fn freezeAndNumbering(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i8t: Type = ctx.int8()
    local f: Function = m.addFunction(String("f"), sig1(&ctx, i8t, i8t))
    local b: Builder = Builder(&ctx)
    // An unnamed entry block takes a number after the arguments, so the first result is %2.
    b.setInsertPoint(f.addBlock(String("")))
    local fr: Value = b.freeze(f.arg(0))
    b.ret(fr)
    local s: String = text(&m)
    expectHas(t, &s, "define i8 @f(i8 %0) {\n  %2 = freeze i8 %0\n  ret i8 %2\n}\n")
}

fn rejectsMismatch(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig2(&ctx, ctx.int32(), ctx.int32(), ctx.int64()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.add(f.arg(0), f.arg(1))
    b.ret(f.arg(0))
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: binary operation: the operand types differ")
}

fn rejectsWrongKind(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.float64(), ctx.float64()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local v: Value = b.add(f.arg(0), f.arg(0))      // add on doubles
    b.ret(v)
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: binary operation: the operand type does not fit the operation")
    expectTrue(t, ctx.hasError())
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "integer operations", intOps)
    test(&s, "wrap and exact flags", wrapFlags)
    test(&s, "floating-point operations", floatOps)
    test(&s, "freeze and numbering of an unnamed entry block", freezeAndNumbering)
    test(&s, "rejects operands of different types", rejectsMismatch)
    test(&s, "rejects an operation of the wrong kind", rejectsWrongKind)
    return suiteRun(&s)
}
