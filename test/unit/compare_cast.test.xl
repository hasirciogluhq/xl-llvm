// Comparisons and conversions. https://llvm.org/docs/LangRef.html#icmp-instruction and
// https://llvm.org/docs/LangRef.html#conversion-operations
from "std" import String, Vec
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEqStr
from "support" import text, expectHas, sig1, sig2
import * from "xl-llvm"

fn integerCompares(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, ctx.int1(), i32t, i32t))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local x: Value = f.arg(0)
    local y: Value = f.arg(1)
    b.icmp(IntPred.Eq, x, y)
    b.icmp(IntPred.Ne, x, y)
    b.icmp(IntPred.Ugt, x, y)
    b.icmp(IntPred.Uge, x, y)
    b.icmp(IntPred.Ult, x, y)
    b.icmp(IntPred.Ule, x, y)
    b.icmp(IntPred.Sgt, x, y)
    b.icmp(IntPred.Sge, x, y)
    b.icmp(IntPred.Slt, x, y)
    local last: Value = b.icmp(IntPred.Sle, x, y)
    b.ret(last)
    local s: String = text(&m)
    expectHas(t, &s, "  %2 = icmp eq i32 %0, %1\n")
    expectHas(t, &s, "  %3 = icmp ne i32 %0, %1\n")
    expectHas(t, &s, "  %4 = icmp ugt i32 %0, %1\n")
    expectHas(t, &s, "  %5 = icmp uge i32 %0, %1\n")
    expectHas(t, &s, "  %6 = icmp ult i32 %0, %1\n")
    expectHas(t, &s, "  %7 = icmp ule i32 %0, %1\n")
    expectHas(t, &s, "  %8 = icmp sgt i32 %0, %1\n")
    expectHas(t, &s, "  %9 = icmp sge i32 %0, %1\n")
    expectHas(t, &s, "  %10 = icmp slt i32 %0, %1\n")
    expectHas(t, &s, "  %11 = icmp sle i32 %0, %1\n")
    expectHas(t, &s, "  ret i1 %11\n")
}

fn pointerAndFloatCompares(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local d: Type = ctx.float64()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, ctx.int1(), d, ctx.ptr()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.fcmp(FloatPred.Olt, f.arg(0), f.arg(0))
    b.fcmp(FloatPred.Une, f.arg(0), f.arg(0))
    b.fcmp(FloatPred.Uno, f.arg(0), f.arg(0))
    local isNull: Value = b.icmp(IntPred.Eq, f.arg(1), ctx.null())
    b.ret(isNull)
    local s: String = text(&m)
    expectHas(t, &s, "  %2 = fcmp olt double %0, %0\n")
    expectHas(t, &s, "  %3 = fcmp une double %0, %0\n")
    expectHas(t, &s, "  %4 = fcmp uno double %0, %0\n")
    expectHas(t, &s, "  %5 = icmp eq ptr %1, null\n")
}

fn casts(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("f"), sig2(&ctx, ctx.voidType(), i32t, ctx.float64()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local x: Value = f.arg(0)
    local d: Value = f.arg(1)
    b.trunc(x, ctx.int8())
    b.zext(x, ctx.int64())
    b.sext(x, ctx.int64())
    b.cast(CastOp.FpTrunc, d, ctx.float32())
    local single: Value = b.cast(CastOp.FpTrunc, d, ctx.float32())
    b.cast(CastOp.FpExt, single, ctx.float64())
    b.cast(CastOp.FpToUi, d, i32t)
    b.cast(CastOp.FpToSi, d, i32t)
    b.cast(CastOp.UiToFp, x, ctx.float64())
    b.cast(CastOp.SiToFp, x, ctx.float64())
    local p: Value = b.intToPtr(b.zext(x, ctx.int64()))
    b.ptrToInt(p, ctx.int64())
    b.cast(CastOp.BitCast, x, ctx.float32())
    b.retVoid()
    local s: String = text(&m)
    expectHas(t, &s, "  %2 = trunc i32 %0 to i8\n")
    expectHas(t, &s, "  %3 = zext i32 %0 to i64\n")
    expectHas(t, &s, "  %4 = sext i32 %0 to i64\n")
    expectHas(t, &s, "  %6 = fptrunc double %1 to float\n")
    expectHas(t, &s, "  %7 = fpext float %6 to double\n")
    expectHas(t, &s, "  %8 = fptoui double %1 to i32\n")
    expectHas(t, &s, "  %9 = fptosi double %1 to i32\n")
    expectHas(t, &s, "  %10 = uitofp i32 %0 to double\n")
    expectHas(t, &s, "  %11 = sitofp i32 %0 to double\n")
    expectHas(t, &s, "  %13 = inttoptr i64 %12 to ptr\n")
    expectHas(t, &s, "  %14 = ptrtoint ptr %13 to i64\n")
    expectHas(t, &s, "  %15 = bitcast i32 %0 to float\n")
}

fn compareChecks(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.int1(), ctx.float64()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local r: Value = b.icmp(IntPred.Eq, f.arg(0), f.arg(0))     // icmp on doubles
    b.ret(r)
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: icmp: the operands are not two integers or two pointers of one type")
    local ctx2: Context = Context()
    local m2: Module = Module(&ctx2, String("t"))
    local f2: Function = m2.addFunction(String("f"), sig1(&ctx2, ctx2.int1(), ctx2.int32()))
    local b2: Builder = Builder(&ctx2)
    b2.setInsertPoint(f2.addBlock(String("entry")))
    local r2: Value = b2.fcmp(FloatPred.Oeq, f2.arg(0), f2.arg(0))
    b2.ret(r2)
    local s2: String = text(&m2)
    expectEqStr(t, s2.asStr(), "error: fcmp: the operands are not two floating-point values of one type")
}

fn castChecks(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    local f: Function = m.addFunction(String("f"), sig1(&ctx, ctx.int64(), ctx.int32()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local r: Value = b.trunc(f.arg(0), ctx.int64())             // trunc must narrow
    b.ret(r)
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: cast: the conversion does not fit the operand and target types")
    local ctx2: Context = Context()
    local m2: Module = Module(&ctx2, String("t"))
    local f2: Function = m2.addFunction(String("f"), sig1(&ctx2, ctx2.int64(), ctx2.int32()))
    local b2: Builder = Builder(&ctx2)
    b2.setInsertPoint(f2.addBlock(String("entry")))
    local r2: Value = b2.cast(CastOp.BitCast, f2.arg(0), ctx2.int64())    // widths differ
    b2.ret(r2)
    local s2: String = text(&m2)
    expectEqStr(t, s2.asStr(), "error: cast: the conversion does not fit the operand and target types")
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "icmp predicates", integerCompares)
    test(&s, "fcmp and pointer compares", pointerAndFloatCompares)
    test(&s, "every conversion", casts)
    test(&s, "compares check their operands", compareChecks)
    test(&s, "conversions check their types", castChecks)
    return suiteRun(&s)
}
