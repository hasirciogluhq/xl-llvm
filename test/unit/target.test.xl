// Target triples and data layouts. https://llvm.org/docs/LangRef.html#target-triple
from "std" import String, Option
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEq, expectEqStr, expectTrue
from "support" import text, expectHas
import * from "xl-llvm"

fn parses(text_: str, arch: Arch, os: Os, env: Env, t: *T) {
    local s: String = String(text_)
    local r: Option<Triple> = parseTriple(&s)
    switch r {
        case Option.Some(tr) {
            expectEq(t, tr.arch as i64, arch as i64)
            expectEq(t, tr.os as i64, os as i64)
            expectEq(t, tr.env as i64, env as i64)
        }
        case Option.None { expectTrue(t, false) }
    }
}

fn parsing(t: *T) {
    parses("x86_64-unknown-linux-gnu", Arch.X86_64, Os.Linux, Env.Gnu, t)
    parses("aarch64-unknown-linux-musl", Arch.Aarch64, Os.Linux, Env.Musl, t)
    parses("arm64-apple-macosx", Arch.Aarch64, Os.Macos, Env.None, t)
    parses("x86_64-apple-darwin23.0.0", Arch.X86_64, Os.Macos, Env.None, t)
    parses("x86_64-pc-windows-msvc", Arch.X86_64, Os.Windows, Env.Msvc, t)
    parses("aarch64-pc-windows-msvc", Arch.Aarch64, Os.Windows, Env.Msvc, t)
}

fn rejects(t: *T) {
    local a: String = String("riscv64-unknown-linux-gnu")
    local b: String = String("x86_64-unknown-freebsd")
    local c: String = String("x86_64")
    switch parseTriple(&a) {
        case Option.Some(x) { expectTrue(t, false) }
        case Option.None {}
    }
    switch parseTriple(&b) {
        case Option.Some(x) { expectTrue(t, false) }
        case Option.None {}
    }
    switch parseTriple(&c) {
        case Option.Some(x) { expectTrue(t, false) }
        case Option.None {}
    }
}

fn layouts(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    setTarget(&m, String("x86_64-unknown-linux-gnu"))
    expectEqStr(t, m.dataLayout.asStr(), "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128")
    local m2: Module = Module(&ctx, String("t"))
    setTarget(&m2, String("arm64-apple-macosx"))
    expectEqStr(t, m2.dataLayout.asStr(), "e-m:o-i64:64-i128:128-n32:64-S128")
    local m3: Module = Module(&ctx, String("t"))
    setTarget(&m3, String("x86_64-pc-windows-msvc"))
    expectEqStr(t, m3.dataLayout.asStr(), "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128")
    local m4: Module = Module(&ctx, String("t"))
    setTarget(&m4, String("aarch64-unknown-linux-gnu"))
    expectEqStr(t, m4.dataLayout.asStr(), "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128")
    expectEqStr(t, m4.triple.asStr(), "aarch64-unknown-linux-gnu")
}

fn badTarget(t: *T) {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("t"))
    setTarget(&m, String("sparc-unknown-solaris"))
    local s: String = text(&m)
    expectEqStr(t, s.asStr(), "error: setTarget: unsupported triple")
}

fn host(t: *T) {
    local h: String = hostTriple()
    local r: Option<Triple> = parseTriple(&h)
    switch r {
        case Option.Some(tr) { expectTrue(t, dataLayout(tr).length() > 0) }
        case Option.None { expectTrue(t, false) }
    }
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "triples parse", parsing)
    test(&s, "unsupported triples are rejected", rejects)
    test(&s, "data layouts of the supported targets", layouts)
    test(&s, "an unsupported target is an error", badTarget)
    test(&s, "the host triple is in the table", host)
    return suiteRun(&s)
}
