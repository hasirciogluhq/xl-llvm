// Consumer smoke test: a program that imports the package the way an installed dependency is imported, builds a module through the
// public API and checks the text. The release workflow runs it against the packed archive.
from "std" import String, Vec, Result
import * from "xl-llvm"

@entry fn main() -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("consume"))
    local f: Function = m.addFunction(String("main"), ctx.fnType(ctx.int32(), Vec<Type>()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.ret(ctx.constInt(ctx.int32(), 7))
    local r: Result<String, String> = m.print()
    local code: i32 = 1
    switch r {
        case Result.Ok(s) {
            if s.contains("define i32 @main() {\nentry:\n  ret i32 7\n}\n") { code = 0 }
        }
        case Result.Err(e) {}
    }
    return code
}
