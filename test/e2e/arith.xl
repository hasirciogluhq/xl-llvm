// Integer arithmetic, a counted loop with phi, comparisons and shifts: `main` returns 128.
//   120 (5! by a loop) + 14 (100 / 7) - 2 (100 % 7) = 132; 132 >> 1 = 66; 66 | 1 = 67; 67 ^ 3 = 64; 64 * 2 = 128
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("arith"))
    begin(&m, argc, argv)
    local i32t: Type = ctx.int32()
    local b: Builder = Builder(&ctx)

    // fn fact(n: i32) -> i32: a loop that multiplies 1 * 2 * ... * n
    local p: Vec<Type> = Vec<Type>()
    p.push(i32t)
    local fact: Function = m.addFunction(String("fact"), ctx.fnType(i32t, p))
    fact.setLinkage(Linkage.Internal)
    local entry: Block = fact.addBlock(String("entry"))
    local loop: Block = fact.addBlock(String("loop"))
    local done: Block = fact.addBlock(String("done"))
    b.setInsertPoint(entry)
    b.br(loop)
    b.setInsertPoint(loop)
    local i: Value = b.phi(i32t)
    local acc: Value = b.phi(i32t)
    local accNext: Value = b.mul(acc, i)
    local iNext: Value = b.add(i, ctx.constInt(i32t, 1))
    local more: Value = b.icmp(IntPred.Sle, iNext, fact.arg(0))
    b.condBr(more, loop, done)
    b.addIncoming(i, ctx.constInt(i32t, 1), entry)
    b.addIncoming(i, iNext, loop)
    b.addIncoming(acc, ctx.constInt(i32t, 1), entry)
    b.addIncoming(acc, accNext, loop)
    b.setInsertPoint(done)
    b.ret(accNext)

    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    b.setInsertPoint(f.addBlock(String("entry")))
    local args: Vec<Value> = Vec<Value>()
    args.push(ctx.constInt(i32t, 5))
    local r: Value = b.callFn(fact, args)
    r = b.add(r, b.udiv(ctx.constInt(i32t, 100), ctx.constInt(i32t, 7)))
    r = b.sub(r, b.urem(ctx.constInt(i32t, 100), ctx.constInt(i32t, 7)))
    r = b.ashr(r, ctx.constInt(i32t, 1))
    r = b.bitOr(r, ctx.constInt(i32t, 1))
    r = b.bitXor(r, ctx.constInt(i32t, 3))
    r = b.shl(r, ctx.constInt(i32t, 1))
    b.ret(r)
    return finish(&m)
}
