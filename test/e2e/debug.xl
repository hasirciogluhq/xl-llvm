// Debug info: `twice(x)` carries a DISubprogram, a DILocalVariable behind `llvm.dbg.declare` and `!dbg` locations; `main` returns
// twice(21) = 42. `opt -passes=verify` checks the debug metadata (scopes, locations, the compile unit) and the link keeps it.
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("debug"))
    begin(&m, argc, argv)
    local i32t: Type = ctx.int32()
    local di: DIBuilder = DIBuilder(&m, String("debug.xl"), String("."), String("xl-llvm"))
    local int: Md = di.basicType(String("i32"), 32, String("DW_ATE_signed"))
    local b: Builder = Builder(&ctx)

    local sig: Vec<Md> = Vec<Md>()
    sig.push(int)
    sig.push(int)
    local p1: Vec<Type> = Vec<Type>()
    p1.push(i32t)
    local twice: Function = m.addFunction(String("twice"), ctx.fnType(i32t, p1))
    twice.setLinkage(Linkage.Internal)
    local sp: Md = di.subprogram(twice, String("twice"), 5, di.subroutineType(sig))
    b.setInsertPoint(twice.addBlock(String("entry")))
    local loc: Md = di.location(6, 3, sp)
    b.setDebugLocation(loc)
    local slot: Value = b.alloca(i32t, 4)
    b.store(twice.arg(0), slot, 4)
    di.dbgDeclare(&b, slot, di.variable(sp, String("x"), 1, 5, int), loc)
    local x: Value = b.load(i32t, slot, 4)
    b.ret(b.add(x, x))
    b.clearDebugLocation()

    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    b.setInsertPoint(f.addBlock(String("entry")))
    local args: Vec<Value> = Vec<Value>()
    args.push(ctx.constInt(i32t, 21))
    b.ret(b.callFn(twice, args))
    return finish(&m)
}
