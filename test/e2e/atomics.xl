// atomicrmw, cmpxchg and fence on a global counter: `main` returns 20.
//   counter = 5; atomicrmw add 3 returns the old value 5 (counter is 8); cmpxchg 8 -> 20 succeeds; a second cmpxchg 8 -> 99 fails.
// Compile-only legs run it for every target, because the atomic instructions lower differently on each CPU.
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("atomics"))
    begin(&m, argc, argv)
    local i32t: Type = ctx.int32()
    local counter: Value = m.addGlobal(String("counter"), i32t)
    m.setInitializer(counter, ctx.constInt(i32t, 5))
    m.setGlobalLinkage(counter, Linkage.Internal)
    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    local old: Value = b.atomicRmw(AtomicOp.Add, counter, ctx.constInt(i32t, 3), AtomicOrdering.SeqCst, 4)
    b.fence(AtomicOrdering.SeqCst)
    local won: Value = b.cmpXchg(counter, ctx.constInt(i32t, 8), ctx.constInt(i32t, 20), AtomicOrdering.SeqCst, AtomicOrdering.Monotonic, 4)
    local lost: Value = b.cmpXchg(counter, ctx.constInt(i32t, 8), ctx.constInt(i32t, 99), AtomicOrdering.SeqCst, AtomicOrdering.Monotonic, 4)
    local wonFlag: Value = b.extractValue(won, 1)
    local lostFlag: Value = b.extractValue(lost, 1)
    local good: Value = b.bitAnd(b.bitAnd(wonFlag, b.bitXor(lostFlag, ctx.constBool(true))), b.icmp(IntPred.Eq, old, ctx.constInt(i32t, 5)))
    local now: Value = b.load(i32t, counter, 4)
    b.ret(b.select(good, now, ctx.constInt(i32t, 0)))
    return finish(&m)
}
