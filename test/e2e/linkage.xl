// Linkage, visibility and attributes have no run-time effect, so the symbol table of the object file is checked (llvm-nm):
//   `main` and `exported` are external, `helper` is internal (not in the global symbols), `weakFn` is weak, `table` is a global.
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("linkage"))
    begin(&m, argc, argv)
    local i32t: Type = ctx.int32()
    local fnTy: Type = ctx.fnType(i32t, Vec<Type>())
    local b: Builder = Builder(&ctx)

    local table: Value = m.addGlobal(String("table"), i32t)
    m.setInitializer(table, ctx.constInt(i32t, 3))
    local hiddenTable: Value = m.addGlobal(String("hiddenTable"), i32t)
    m.setInitializer(hiddenTable, ctx.constInt(i32t, 4))
    m.setGlobalVisibility(hiddenTable, Visibility.Hidden)
    local secret: Value = m.addGlobal(String("secret"), i32t)
    m.setInitializer(secret, ctx.constInt(i32t, 5))
    m.setGlobalLinkage(secret, Linkage.Internal)

    local helper: Function = m.addFunction(String("helper"), fnTy)
    helper.setLinkage(Linkage.Internal)
    helper.addAttr(FnAttr.NoInline)
    helper.addAttr(FnAttr.NoUnwind)
    b.setInsertPoint(helper.addBlock(String("entry")))
    b.ret(b.load(i32t, secret, 4))

    local weakFn: Function = m.addFunction(String("weakFn"), fnTy)
    weakFn.setLinkage(Linkage.Weak)
    b.setInsertPoint(weakFn.addBlock(String("entry")))
    b.ret(ctx.constInt(i32t, 1))

    local exported: Function = m.addFunction(String("exported"), fnTy)
    exported.setVisibility(Visibility.Hidden)
    b.setInsertPoint(exported.addBlock(String("entry")))
    b.ret(b.add(b.callFn(helper, Vec<Value>()), b.load(i32t, table, 4)))

    local f: Function = m.addFunction(String("main"), fnTy)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.ret(b.add(b.callFn(exported, Vec<Value>()), b.add(b.callFn(weakFn, Vec<Value>()), b.load(i32t, hiddenTable, 4))))
    return finish(&m)
}
