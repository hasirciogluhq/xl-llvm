// Globals, struct and array layout, getelementptr, alloca, load/store and the memcpy/memset intrinsics: `main` returns 12 + 7 = 19.
// A global array of three { i32, i32 } points is copied with memcpy, the copy's `y` fields are summed (2 + 4 + 6 = 12), and a
// zeroed stack slot is set to 7.
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

fn list(a: Value, b: Value, c: Value, d: Value) -> Vec<Value> {
    local l: Vec<Value> = Vec<Value>()
    l.push(a)
    l.push(b)
    l.push(c)
    l.push(d)
    return l
}

@entry fn main() -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("memory"))
    begin(&m)
    local i32t: Type = ctx.int32()
    local i64t: Type = ctx.int64()
    local fields: Vec<Type> = Vec<Type>()
    fields.push(i32t)
    fields.push(i32t)
    local point: Type = ctx.structType(fields, false)
    local points: Type = ctx.arrayType(point, 3)

    // @points = internal constant [3 x { i32, i32 }] [ {1,2}, {3,4}, {5,6} ]
    local elems: Vec<Value> = Vec<Value>()
    for k in 0..3 {
        local pair: Vec<Value> = Vec<Value>()
        pair.push(ctx.constInt(i32t, (2 * k + 1) as i64))
        pair.push(ctx.constInt(i32t, (2 * k + 2) as i64))
        elems.push(ctx.constStruct(point, pair))
    }
    local table: Value = m.addGlobal(String("points"), points)
    m.setInitializer(table, ctx.constArray(points, elems))
    m.setConstant(table, true)
    m.setGlobalLinkage(table, Linkage.Internal)

    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    local b: Builder = Builder(&ctx)
    local entry: Block = f.addBlock(String("entry"))
    local loop: Block = f.addBlock(String("loop"))
    local done: Block = f.addBlock(String("done"))
    b.setInsertPoint(entry)
    local copy: Value = b.alloca(points, 4)
    local size: Value = ctx.constInt(i64t, 24)
    b.callFn(memcpy(&m), list(copy, table, size, ctx.constBool(false)))
    local slot: Value = b.alloca(i32t, 4)
    b.callFn(memset(&m), list(slot, ctx.constInt(ctx.int8(), 0), ctx.constInt(i64t, 4), ctx.constBool(false)))
    b.store(ctx.constInt(i32t, 7), slot, 4)
    b.br(loop)

    b.setInsertPoint(loop)
    local i: Value = b.phi(i64t)
    local sum: Value = b.phi(i32t)
    local idx: Vec<Value> = Vec<Value>()
    idx.push(ctx.constInt(i64t, 0))
    idx.push(i)
    idx.push(ctx.constInt(i32t, 1))               // the `y` field
    local y: Value = b.load(i32t, b.gep(points, copy, idx, true), 4)
    local sumNext: Value = b.add(sum, y)
    local iNext: Value = b.add(i, ctx.constInt(i64t, 1))
    b.condBr(b.icmp(IntPred.Ult, iNext, ctx.constInt(i64t, 3)), loop, done)
    b.addIncoming(i, ctx.constInt(i64t, 0), entry)
    b.addIncoming(i, iNext, loop)
    b.addIncoming(sum, ctx.constInt(i32t, 0), entry)
    b.addIncoming(sum, sumNext, loop)

    b.setInsertPoint(done)
    b.ret(b.add(sumNext, b.load(i32t, slot, 4)))
    return finish(&m)
}
