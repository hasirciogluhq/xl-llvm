// The tools layer: verify, optimize, bitcode, object and assembly on a real module, and the error of a rejected module.
// Prints "tools ok" when every step behaves.
from "std" import String, Vec, Option, Result, print, println
import * from "xl-llvm"

/// Checks `cond` and reports the failing step; returns the number of failures (0 or 1).
fn check(cond: bool, step: str) -> i32 {
    if cond { return 0 }
    print("FAIL: ")
    println(step)
    return 1
}

/// `i32 @main() { ret i32 (2 * 3) }` built with an add of two constants that -O2 folds into `ret i32 6`.
fn module(ctx: *Context, m: *Module) {
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    local b: Builder = Builder(ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    b.ret(b.mul(ctx.constInt(i32t, 2), ctx.constInt(i32t, 3)))
}

@entry fn main() -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("tools"))
    setTarget(&m, hostTriple())
    module(&ctx, &m)
    local text: String = String()
    local printed: Result<String, String> = m.print()
    switch printed {
        case Result.Ok(s) { text = s.clone() }
        case Result.Err(e) {
            println(&e)
            return 1
        }
    }
    local failures: i32 = 0
    local tools: Tools = Tools()

    local verdict: Option<String> = tools.verify(&text)
    switch verdict {
        case Option.Some(e) { failures += check(false, "verify accepts a valid module") }
        case Option.None {}
    }

    // an operand of the wrong type that the builder does not catch because the text is written by hand
    local broken: String = String("define i32 @f() {\n  ret i64 1\n}\n")
    local rejected: Option<String> = tools.verify(&broken)
    switch rejected {
        case Option.Some(e) { failures += check(e.length() > 0, "verify reports why it rejects a module") }
        case Option.None { failures += check(false, "verify rejects a mistyped ret") }
    }

    local folded: Result<String, String> = tools.optimize(&text, 2)
    switch folded {
        case Result.Ok(s) { failures += check(s.contains("ret i32 6"), "-O2 folds 2 * 3 into 6") }
        case Result.Err(e) { failures += check(false, "optimize runs opt") }
    }

    local bitcode: Result<String, String> = tools.bitcode(&text)
    switch bitcode {
        case Result.Ok(s) {
            // raw bitcode starts with 'B' 'C'; for Apple triples LLVM writes the wrapper header 0x0B17C0DE (little endian: DE C0 17 0B)
            local raw: bool = s.length() > 4 && s.at(0) == b'B' && s.at(1) == b'C'
            local wrapped: bool = s.length() > 4 && s.at(0) == 0xDE && s.at(1) == 0xC0 && s.at(2) == 0x17 && s.at(3) == 0x0B
            failures += check(raw || wrapped, "bitcode starts with the BC magic or the wrapper header")
        }
        case Result.Err(e) { failures += check(false, "bitcode runs llvm-as") }
    }

    local triple: String = String()
    local object: Result<String, String> = tools.object(&text, &triple, 0)
    switch object {
        case Result.Ok(s) { failures += check(s.length() > 64, "object is a non-empty object file") }
        case Result.Err(e) { failures += check(false, "object runs llc") }
    }

    local assembly: Result<String, String> = tools.assembly(&text, &triple, 0)
    switch assembly {
        case Result.Ok(s) { failures += check(s.contains("main"), "assembly defines main") }
        case Result.Err(e) { failures += check(false, "assembly runs llc") }
    }

    local missing: Tools = Tools(String("/nonexistent-llvm-dir"))
    local lost: Option<String> = missing.verify(&text)
    switch lost {
        case Option.Some(e) { failures += check(e.contains("cannot start"), "a missing tool is reported") }
        case Option.None { failures += check(false, "a missing tool is an error") }
    }

    if failures == 0 { println("tools ok") }
    return failures
}
