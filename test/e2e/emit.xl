// Shared by the e2e programs. Each program builds one module through the xl-llvm API and prints its IR text on stdout (with
// `Module.printTo`); `run.sh` then verifies the text with `opt`, compiles it with `llc` or `clang`, links, runs it and checks the result.
//
// Usage of a program:  <program> [target-triple]     (no argument: the triple of the host)
from "std" import String, Option, Stream, eprint, fromC
import * from "xl-llvm"

/// Sets the target of `m` from `argv[1]`, or the host triple without it.
export fn begin(m: *Module, argc: i32, argv: **u8) {
    if argc > 1 {
        setTarget(m, String(fromC(argv[1])))
    } else {
        setTarget(m, hostTriple())
    }
}

/// The target triple of `m` parsed; the programs that depend on the CPU or OS read it.
export fn targetOf(m: *Module) -> Triple {
    local out: Triple = Triple { arch: Arch.Other, os: Os.Other, env: Env.None }
    local parsed: Option<Triple> = parseTriple(&m.triple)
    switch parsed {
        case Option.Some(t) { out = t }
        case Option.None {}
    }
    return out
}

/// Writes the module to standard output; 0, or 2 after printing the error on stderr.
export fn finish(m: *Module) -> i32 {
    local stdout: Stream = Stream(1, false)
    local problem: Option<String> = m.printTo(&stdout)
    local code: i32 = 0
    switch problem {
        case Option.Some(e) {
            eprint(&e)
            eprint("\n")
            code = 2
        }
        case Option.None {}
    }
    return code
}
