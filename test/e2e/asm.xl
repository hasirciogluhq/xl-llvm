// Inline assembly: one instruction that loads 42 into a register, in the dialect and syntax of the target; `main` returns 42.
// x86-64 uses AT&T syntax in one function and the Intel dialect in another (both must give 42); arm64 has one dialect.
from "std" import String, Vec
from "emit" import begin, finish, targetOf
import * from "xl-llvm"

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("asm"))
    begin(&m, argc, argv)
    local i32t: Type = ctx.int32()
    local fnTy: Type = ctx.fnType(i32t, Vec<Type>())
    local b: Builder = Builder(&ctx)
    local target: Triple = targetOf(&m)

    local att: Function = m.addFunction(String("att"), fnTy)
    att.setLinkage(Linkage.Internal)
    b.setInsertPoint(att.addBlock(String("entry")))
    local first: Value = ctx.inlineAsm(String("mov $0, #42"), String("=r"), false, false)
    if target.arch == Arch.X86_64 {
        first = ctx.inlineAsm(String("movl $$42, $0"), String("=r"), false, false)    // `$$` is a literal `$`
    }
    b.ret(b.call(first, fnTy, Vec<Value>()))

    local intel: Function = m.addFunction(String("intel"), fnTy)
    intel.setLinkage(Linkage.Internal)
    b.setInsertPoint(intel.addBlock(String("entry")))
    local second: Value = ctx.inlineAsm(String("mov $0, #42"), String("=r"), false, false)
    if target.arch == Arch.X86_64 {
        second = ctx.inlineAsm(String("mov $0, 42"), String("=r"), false, true)
    }
    b.ret(b.call(second, fnTy, Vec<Value>()))

    local f: Function = m.addFunction(String("main"), fnTy)
    b.setInsertPoint(f.addBlock(String("entry")))
    local a: Value = b.callFn(att, Vec<Value>())
    local c: Value = b.callFn(intel, Vec<Value>())
    b.ret(b.select(b.icmp(IntPred.Eq, a, c), a, ctx.constInt(i32t, 0)))
    return finish(&m)
}
