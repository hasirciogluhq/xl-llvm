// Floating point: double and float arithmetic, fneg, fcmp, fpext/fptrunc, fptosi/sitofp: `main` returns 7.
//   (1.5 * 4.0 + 1.0) = 7.0 in double; the same through float; both agree, so the result is 7, else 0.
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

@entry fn main() -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("floats"))
    begin(&m)
    local i32t: Type = ctx.int32()
    local d: Type = ctx.float64()
    local s: Type = ctx.float32()
    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    local b: Builder = Builder(&ctx)
    b.setInsertPoint(f.addBlock(String("entry")))
    // a stack slot hides the values from constant folding at -O0 front ends, not from LLVM; the result is the same either way
    local slot: Value = b.alloca(d, 8)
    b.store(ctx.constFloat(d, 1.5), slot, 8)
    local x: Value = b.load(d, slot, 8)
    local wide: Value = b.fadd(b.fmul(x, ctx.constFloat(d, 4.0)), ctx.constFloat(d, 1.0))
    local narrow: Value = b.fadd(b.fmul(b.cast(CastOp.FpTrunc, x, s), ctx.constFloat(s, 4.0)), ctx.constFloat(s, 1.0))
    local back: Value = b.cast(CastOp.FpExt, narrow, d)
    local same: Value = b.fcmp(FloatPred.Oeq, wide, back)
    local negated: Value = b.fneg(b.fneg(wide))
    local intRes: Value = b.cast(CastOp.FpToSi, negated, i32t)
    local viaInt: Value = b.cast(CastOp.SiToFp, intRes, d)
    local exact: Value = b.fcmp(FloatPred.Oeq, viaInt, wide)
    local both: Value = b.bitAnd(same, exact)
    b.ret(b.select(both, intRes, ctx.constInt(i32t, 0)))
    return finish(&m)
}
