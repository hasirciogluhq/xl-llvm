// switch, indirectbr with blockaddress (computed goto), unreachable and select: `main` returns 30 + 7 = 37.
//   switch 3 -> 30; computed goto to the second of two blocks -> 7
from "std" import String, Vec
from "emit" import begin, finish
import * from "xl-llvm"

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local ctx: Context = Context()
    local m: Module = Module(&ctx, String("control"))
    begin(&m, argc, argv)
    local i32t: Type = ctx.int32()
    local f: Function = m.addFunction(String("main"), ctx.fnType(i32t, Vec<Type>()))
    local b: Builder = Builder(&ctx)
    local entry: Block = f.addBlock(String("entry"))
    local one: Block = f.addBlock(String("one"))
    local three: Block = f.addBlock(String("three"))
    local other: Block = f.addBlock(String("other"))
    local join: Block = f.addBlock(String("join"))
    local hopA: Block = f.addBlock(String("hopA"))
    local hopB: Block = f.addBlock(String("hopB"))
    local end: Block = f.addBlock(String("end"))

    // switch on a value the optimizer does not see through: the address of nothing, an alloca loaded back
    b.setInsertPoint(entry)
    local slot: Value = b.alloca(i32t, 4)
    b.store(ctx.constInt(i32t, 3), slot, 4)
    local v: Value = b.load(i32t, slot, 4)
    local values: Vec<Value> = Vec<Value>()
    values.push(ctx.constInt(i32t, 1))
    values.push(ctx.constInt(i32t, 3))
    local targets: Vec<Block> = Vec<Block>()
    targets.push(one)
    targets.push(three)
    b.switchTo(v, other, values, targets)
    b.setInsertPoint(one)
    b.br(join)
    b.setInsertPoint(three)
    b.br(join)
    b.setInsertPoint(other)
    b.unreachable()

    b.setInsertPoint(join)
    local first: Value = b.phi(i32t)
    b.addIncoming(first, ctx.constInt(i32t, 10), one)
    b.addIncoming(first, ctx.constInt(i32t, 30), three)
    // computed goto: the address is chosen by a select between two block addresses
    local pickB: Value = b.icmp(IntPred.Eq, first, ctx.constInt(i32t, 30))
    local addr: Value = b.select(pickB, m.blockAddress(f, hopB), m.blockAddress(f, hopA))
    local dests: Vec<Block> = Vec<Block>()
    dests.push(hopA)
    dests.push(hopB)
    b.indirectBr(addr, dests)
    b.setInsertPoint(hopA)
    b.br(end)
    b.setInsertPoint(hopB)
    b.br(end)
    b.setInsertPoint(end)
    local second: Value = b.phi(i32t)
    b.addIncoming(second, ctx.constInt(i32t, 0), hopA)
    b.addIncoming(second, ctx.constInt(i32t, 7), hopB)
    b.ret(b.add(first, second))
    return finish(&m)
}
