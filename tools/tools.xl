// tools/tools: runs the LLVM command-line tools on IR text. This is the platform-related part of the package; everything else
// works with no LLVM installed.
//
//   verify    opt -passes=verify          https://llvm.org/docs/CommandGuide/opt.html
//   optimize  opt -O<n> -S                https://llvm.org/docs/NewPassManager.html
//   bitcode   llvm-as                     https://llvm.org/docs/CommandGuide/llvm-as.html
//   object    llc -filetype=obj           https://llvm.org/docs/CommandGuide/llc.html
//   assembly  llc -filetype=asm
//
// Each call writes the IR to a temporary file, runs the tool and removes the file. A tool that fails gives its standard error
// as the `Err`. The tools are found on `PATH`, or in the directory given to `Tools(dir)`. Supported LLVM: 18 and newer (the
// opaque-pointer text syntax and `-passes=`); the version pinned in CI is in FEATURES.md.
from "std" import String, Vec, Option, Result, format, fsWrite, fsReadAllString, fsRemove
from "std/os/process" import Command, ProcessError
from "std/os/process" import id as processId
from "std/os" import env

global tempCounter: u64 = 0

/// The directory for temporary files: `TMPDIR` or `TEMP`, else `/tmp`.
fn tempDir() -> String {
    local dir: String = String("/tmp")
    local names: Vec<String> = Vec<String>()
    names.push(String("TEMP"))        // Windows
    names.push(String("TMPDIR"))      // POSIX; read last so it wins when both are set
    for i in 0..names.length() {
        local found: Option<String> = env.get(names.get(i))
        switch found {
            case Option.Some(v) { dir = v.clone() }
            case Option.None {}
        }
    }
    return dir
}

/// A fresh temporary path with extension `ext`.
fn tempPath(ext: *String) -> String {
    local dir: String = tempDir()
    tempCounter += 1
    return format("{}/xlllvm_{}_{}.{}", &dir, processId() as i64, tempCounter, ext)
}

export class Tools {
    dir: String         // the directory that holds the tools; empty: look them up on PATH

    fn init(self) {}

    fn init(self, dir: String) {
        self.dir = dir
    }

    /// The path of the tool `name`.
    fn program(self, name: *String) -> String {
        if self.dir.length() == 0 { return name.clone() }
        return format("{}/{}", &self.dir, name)
    }

    /// Runs the tool `name` with `args`; its standard output on success, its standard error (or a start error) otherwise.
    fn exec(self, name: String, args: Vec<String>) -> Result<String, String> {
        local cmd: Command = Command(self.program(&name))
        for i in 0..args.length() { cmd.arg(args.get(i).clone()) }
        local started: Option<ProcessError> = cmd.output()
        local failure: String = String()
        switch started {
            case Option.Some(e) { failure = format("{}: cannot start the tool (error {})", &name, e.code as i64) }
            case Option.None {
                if !cmd.status.success {
                    failure = format("{} failed with exit code {}", &name, cmd.status.code as i64)
                    if cmd.errText.length() > 0 {
                        failure.append(":\n")
                        failure.append(&cmd.errText)
                    }
                }
            }
        }
        if failure.length() > 0 { return Result.Err(failure) }
        return Result.Ok(cmd.outText.clone())
    }

    /// Writes `ir` to a temporary `.ll` file and runs `tool` as `tool <before...> <file> [-o <out>]`; the tool's standard
    /// output, or its error. The temporary file is removed.
    fn runOn(self, tool: String, ir: *String, before: Vec<String>, out: *String) -> Result<String, String> {
        local ext: String = String("ll")
        local path: String = tempPath(&ext)
        if !fsWrite(path.cstr(), ir.asStr()) { return Result.Err(format("cannot write {}", &path)) }
        local args: Vec<String> = Vec<String>()
        for i in 0..before.length() { args.push(before.get(i).clone()) }
        args.push(path.clone())
        if out.length() > 0 {
            args.push(String("-o"))
            args.push(out.clone())
        }
        local r: Result<String, String> = self.exec(tool, args)
        fsRemove(path.cstr())
        return r
    }

    /// Checks that `ir` is well-formed IR (syntax, types, dominance); None when it is, otherwise the verifier's message.
    fn verify(self, ir: *String) -> Option<String> {
        local before: Vec<String> = Vec<String>()
        before.push(String("-passes=verify"))
        before.push(String("-disable-output"))
        local none: String = String()
        local r: Result<String, String> = self.runOn(String("opt"), ir, before, &none)
        local problem: Option<String> = Option.None
        switch r {
            case Result.Err(e) { problem = Option.Some(e.clone()) }      // a payload bound by `switch` is a copy: clone to keep it
            case Result.Ok(o) {}
        }
        return problem
    }

    /// `ir` optimized at level 0 to 3 (`opt -O<level>`), as text.
    fn optimize(self, ir: *String, level: u32) -> Result<String, String> {
        local before: Vec<String> = Vec<String>()
        before.push(format("-O{}", level as u64))
        before.push(String("-S"))
        local none: String = String()
        return self.runOn(String("opt"), ir, before, &none)
    }

    /// Runs `tool` over `ir`, with `before` arguments and an output file of extension `ext`; the bytes of that file.
    fn toFile(self, tool: String, ir: *String, ext: String, before: Vec<String>) -> Result<String, String> {
        local outPath: String = tempPath(&ext)
        local r: Result<String, String> = self.runOn(tool, ir, before, &outPath)
        local result: Result<String, String> = Result.Ok(String())
        switch r {
            case Result.Err(e) { result = Result.Err(e.clone()) }
            case Result.Ok(o) { result = Result.Ok(fsReadAllString(outPath.cstr())) }
        }
        fsRemove(outPath.cstr())
        return result
    }

    /// LLVM bitcode (`.bc`) of `ir`, as bytes.
    fn bitcode(self, ir: *String) -> Result<String, String> {
        return self.toFile(String("llvm-as"), ir, String("bc"), Vec<String>())
    }

    fn codegen(self, ir: *String, kind: String, ext: String, triple: *String, level: u32) -> Result<String, String> {
        local before: Vec<String> = Vec<String>()
        before.push(format("-filetype={}", &kind))
        before.push(format("-O{}", level as u64))
        if triple.length() > 0 { before.push(format("-mtriple={}", triple)) }
        return self.toFile(String("llc"), ir, ext, before)
    }

    /// A relocatable object file of `ir` for `triple` (empty: the module's own triple) at optimization level 0 to 3, as bytes.
    fn object(self, ir: *String, triple: *String, level: u32) -> Result<String, String> {
        return self.codegen(ir, String("obj"), String("o"), triple, level)
    }

    /// Target assembly of `ir` for `triple` (empty: the module's own triple), as text.
    fn assembly(self, ir: *String, triple: *String, level: u32) -> Result<String, String> {
        return self.codegen(ir, String("asm"), String("s"), triple, level)
    }
}
